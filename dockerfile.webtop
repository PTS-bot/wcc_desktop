# เริ่มจาก Base Image Kali ของ LinuxServer
FROM lscr.io/linuxserver/kali-linux:latest

# ป้องกันการถามคำถามระหว่างติดตั้ง
ENV DEBIAN_FRONTEND=noninteractive

# 1. ติดตั้ง Dependencies พื้นฐานที่จำเป็นสำหรับ SET และอื่นๆ
RUN apt-get update && \
    apt-get install -y \
    git \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    libssl-dev \
    libffi-dev \
    python3-dev \
    xclip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 2. ติดตั้ง Social Engineering Toolkit (SET)
WORKDIR /opt
RUN git clone https://github.com/trustedsec/social-engineer-toolkit.git setoolkit
WORKDIR /opt/setoolkit
RUN pip3 install -r requirements.txt --break-system-packages
RUN python3 setup.py install
RUN ln -sf /usr/local/bin/setoolkit /usr/bin/setoolkit

# -------------------------------------------------------
# 3. เรียกใช้ Script ติดตั้ง Jupyter
# -------------------------------------------------------
# Copy ไฟล์ script เข้าไป
# ... (ส่วนบนเหมือนเดิม จนถึงบรรทัด copy install_jupyter.sh) ...

# 3. เรียกใช้ Script ติดตั้ง Jupyter
COPY install_jupyter.sh /tmp/install_jupyter.sh
RUN sed -i 's/\r$//' /tmp/install_jupyter.sh && \
    chmod +x /tmp/install_jupyter.sh && \
    /tmp/install_jupyter.sh && \
    rm /tmp/install_jupyter.sh

# 4. ตั้งค่า Service ให้ Jupyter รันอัตโนมัติ
# 🔥 แก้จุดนี้: เปลี่ยนคำสั่ง exec ให้รันในนาม user abc
RUN mkdir -p /etc/services.d/jupyter && \
    echo '#!/bin/bash' > /etc/services.d/jupyter/run && \
    echo 'exec s6-setuidgid abc jupyter lab --config=/opt/jupyter_lab_config.py' >> /etc/services.d/jupyter/run && \
    chmod +x /etc/services.d/jupyter/run

WORKDIR /config